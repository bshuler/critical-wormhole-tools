{
    "version": "0.4.0",
    "description": "Secure network utilities using Magic Wormhole code-based addressing",
    "homepage": "https://github.com/bshuler/critical-wormhole-tools",
    "license": "MIT",
    "notes": "Use 'wh --help' to see available commands",
    "depends": "python",
    "url": "https://github.com/bshuler/critical-wormhole-tools/releases/download/v0.4.0/critical-wormhole-tools-0.4.0-windows.zip",
    "hash": "PLACEHOLDER_SHA256",
    "extract_dir": "critical-wormhole-tools-0.4.0",
    "installer": {
        "script": [
            "python -m pip install --user critical-wormhole-tools==$version"
        ]
    },
    "uninstaller": {
        "script": [
            "python -m pip uninstall -y critical-wormhole-tools"
        ]
    },
    "bin": [],
    "env_add_path": "$dir",
    "checkver": {
        "github": "https://github.com/bshuler/critical-wormhole-tools"
    },
    "autoupdate": {
        "url": "https://github.com/bshuler/critical-wormhole-tools/releases/download/v$version/critical-wormhole-tools-$version-windows.zip"
    },
    "suggest": {
        "Python": "python"
    }
}
