{
  "manifest_version": 3,
  "name": "Wormhole Browser",
  "version": "0.4.0",
  "description": "Browse websites hosted on wormhole addresses (wh://)",
  "author": "Critical Wormhole Team",
  "homepage_url": "https://github.com/bshuler/critical-wormhole-tools",

  "options_page": "settings.html",

  "permissions": [
    "proxy",
    "storage",
    "nativeMessaging"
  ],

  "host_permissions": [
    "http://localhost:9475/*",
    "<all_urls>"
  ],

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/wormhole-16.png",
      "32": "icons/wormhole-32.png",
      "48": "icons/wormhole-48.png",
      "128": "icons/wormhole-128.png"
    },
    "default_title": "Wormhole Browser"
  },

  "icons": {
    "16": "icons/wormhole-16.png",
    "32": "icons/wormhole-32.png",
    "48": "icons/wormhole-48.png",
    "128": "icons/wormhole-128.png"
  },

  "web_accessible_resources": [{
    "resources": ["src/proxy.pac"],
    "matches": ["<all_urls>"]
  }],

  "browser_specific_settings": {
    "gecko": {
      "id": "wormhole-browser@critical-wormhole.tools",
      "strict_min_version": "109.0"
    }
  }
}
