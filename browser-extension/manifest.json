{
  "manifest_version": 3,
  "name": "Wormhole Browser",
  "version": "0.5.0",
  "description": "Browse websites hosted on wormhole addresses (wh://)",
  "author": "Critical Wormhole Team",
  "homepage_url": "https://github.com/bshuler/critical-wormhole-tools",

  "options_page": "settings.html",

  "permissions": [
    "proxy",
    "storage",
    "scripting",
    "tabs"
  ],

  "omnibox": {
    "keyword": "wh"
  },

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/wormhole-16.png",
      "32": "icons/wormhole-32.png",
      "48": "icons/wormhole-48.png",
      "128": "icons/wormhole-128.png"
    },
    "default_title": "Wormhole Browser"
  },

  "icons": {
    "16": "icons/wormhole-16.png",
    "32": "icons/wormhole-32.png",
    "48": "icons/wormhole-48.png",
    "128": "icons/wormhole-128.png"
  },

  "web_accessible_resources": [{
    "resources": ["proxy.pac", "content/navigation.js"],
    "matches": ["<all_urls>"]
  }],

  "sandbox": {
    "pages": ["sandbox.html"]
  },

  "content_security_policy": {
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; child-src 'self' blob:; worker-src 'self' blob:;"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "wormhole-browser@critical-wormhole.tools",
      "strict_min_version": "109.0"
    }
  }
}
