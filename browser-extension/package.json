{
  "name": "wormhole-browser",
  "version": "0.4.0",
  "description": "Browse websites hosted on wormhole addresses (wh://)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:functional": "vitest run --project functional",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test && npm run test:e2e",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "package": "npm run build && web-ext build -s dist",
    "package:chrome": "npm run build && cd dist && zip -r ../wormhole-browser-chrome.zip .",
    "package:firefox": "npm run build && web-ext build -s dist -a artifacts"
  },
  "dependencies": {
    "@noble/ed25519": "^2.0.0",
    "@noble/hashes": "^1.3.0",
    "buffer": "^6.0.3",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.0.280",
    "@vitest/coverage-v8": "^2.1.0",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^9.17.0",
    "happy-dom": "^20.1.0",
    "jsdom": "^27.4.0",
    "vitest": "^2.1.0",
    "web-ext": "^8.3.0",
    "webpack": "^5.97.0",
    "webpack-cli": "^6.0.1"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Edge versions"
  ],
  "author": "Critical Wormhole Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bshuler/critical-wormhole-tools.git",
    "directory": "browser-extension"
  },
  "keywords": [
    "wormhole",
    "browser-extension",
    "p2p",
    "decentralized",
    "wns"
  ]
}
