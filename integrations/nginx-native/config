ngx_addon_name=ngx_http_wormhole_module

if test -n "$ngx_module_link"; then
    # nginx 1.9.11+
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_wormhole_module
    ngx_module_srcs="$ngx_addon_dir/ngx_http_wormhole_module.c"
    . auto/module
else
    # nginx < 1.9.11
    HTTP_MODULES="$HTTP_MODULES ngx_http_wormhole_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_addon_dir/ngx_http_wormhole_module.c"
fi
