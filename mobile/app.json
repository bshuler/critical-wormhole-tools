{
  "expo": {
    "name": "Wormhole",
    "slug": "wormhole-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A5568"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wormhole.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan QR codes to connect to peers",
        "NSPhotoLibraryUsageDescription": "Save QR codes for sharing"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A5568"
      },
      "package": "com.wormhole.mobile",
      "permissions": [
        "INTERNET",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Wormhole to scan QR codes for peer connections"
        }
      ]
    ]
  }
}
