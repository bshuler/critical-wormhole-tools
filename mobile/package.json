{
  "name": "wormhole-mobile",
  "version": "0.1.0",
  "description": "Wormhole Name System mobile browser and peer connector",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{js,jsx,json,md}\""
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.72.6",
    "expo": "~49.0.15",
    "expo-status-bar": "~1.6.0",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/stack": "^6.3.20",
    "react-native-screens": "~3.24.0",
    "react-native-safe-area-context": "4.6.3",
    "@react-native-async-storage/async-storage": "1.18.2",
    "react-native-get-random-values": "^1.11.0",
    "libsodium-wrappers": "^0.7.11",
    "react-native-webview": "13.2.2",
    "react-native-qrcode-svg": "^6.2.0",
    "react-native-camera": "^4.2.1",
    "react-native-svg": "^13.9.0",
    "expo-barcode-scanner": "~12.5.3",
    "expo-notifications": "~0.20.1",
    "expo-device": "~5.4.0",
    "expo-task-manager": "~11.3.0",
    "expo-background-fetch": "~11.3.0",
    "@wormhole-tools/protocol": "file:../packages/protocol",
    "react-native-webrtc": "^118.0.0",
    "tweetnacl": "^1.0.3",
    "@noble/hashes": "^1.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@testing-library/react-native": "^12.3.2",
    "jest": "^29.7.0",
    "jest-expo": "~49.0.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "private": true
}
